{
  "doctype": "DocType",
  "name": "Monthly Attendance Import Policy",
  "module": "Monthly Attendance Import",
  "engine": "InnoDB",
  "field_order": [
    "company",
    "enabled",
    "identifier_field",
    "thresholds_confirmed",
    "present_hours",
    "half_day_hours",
    "half_day_remainder",
    "blank_rule",
    "zero_rule",
    "overtime_only_rule",
    "shift_rule",
    "holiday_rule",
    "ea_rule",
    "ab_rule",
    "sb_rule",
    "rh_rule",
    "hd_rule",
    "sl_rule",
    "uh_rule",
    "md_rule",
    "overtime_type",
    "standard_working_hours",
    "f_rule",
    "vacation_rule",
    "vacation_leave_type",
    "sl_leave_type"
  ],
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "description": "Complete all required choices before enabling. Select Block for unused codes."
    },
    {
      "fieldname": "identifier_field",
      "label": "Identifier Field",
      "fieldtype": "Select",
      "options": "\nname\nemployee_number",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "thresholds_confirmed",
      "label": "Thresholds Confirmed",
      "fieldtype": "Check",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "present_hours",
      "label": "Present Hours",
      "fieldtype": "Float",
      "description": "Normal hours recorded for P, and the minimum normal hours for numeric entries to count as Present.",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "half_day_hours",
      "label": "Half Day Hours",
      "fieldtype": "Float",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "half_day_remainder",
      "label": "Half Day Remainder",
      "fieldtype": "Select",
      "options": "\nBlock\nAbsent",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "blank_rule",
      "label": "Blank Rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "zero_rule",
      "label": "Zero Rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip\nAbsent",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "overtime_only_rule",
      "label": "Overtime Only Rule",
      "fieldtype": "Select",
      "options": "\nBlock\nRecord only",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "shift_rule",
      "label": "Shift Rule",
      "fieldtype": "Select",
      "options": "\nRequire assignment or default\nNo shift",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "holiday_rule",
      "label": "Holiday Rule",
      "fieldtype": "Select",
      "options": "\nBlock\nUse daily rule\nSkip",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "ea_rule",
      "label": "EA code rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip\nAbsent\nApproved Leave\nPresent\nHalf Day",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "ab_rule",
      "label": "AB code rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip\nAbsent\nApproved Leave\nPresent\nHalf Day",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "sb_rule",
      "label": "SB code rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip\nAbsent\nApproved Leave\nPresent\nHalf Day",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "rh_rule",
      "label": "RH code rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip\nAbsent\nApproved Leave\nPresent\nHalf Day",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "hd_rule",
      "label": "HD code rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip\nAbsent\nApproved Leave\nPresent\nHalf Day",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "sl_rule",
      "label": "SL code rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip\nAbsent\nApproved Leave\nPresent\nHalf Day",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "uh_rule",
      "label": "UH code rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip\nAbsent\nApproved Leave\nPresent\nHalf Day",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "md_rule",
      "label": "MD code rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip\nAbsent\nApproved Leave\nPresent\nHalf Day",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "overtime_type",
      "fieldtype": "Link",
      "options": "Overtime Type",
      "label": "Overtime Type",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "standard_working_hours",
      "fieldtype": "Float",
      "label": "Standard Working Hours",
      "precision": "2",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "f_rule",
      "label": "F Weekly Off Rule",
      "fieldtype": "Select",
      "options": "\nBlock\nSkip attendance; retain overtime",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "vacation_rule",
      "label": "VACATION Rule",
      "fieldtype": "Select",
      "options": "\nBlock\nApproved Leave",
      "mandatory_depends_on": "eval:doc.enabled == 1"
    },
    {
      "fieldname": "vacation_leave_type",
      "label": "VACATION Leave Type",
      "fieldtype": "Link",
      "options": "Leave Type",
      "mandatory_depends_on": "eval:doc.enabled == 1 && doc.vacation_rule == \"Approved Leave\""
    },
    {
      "fieldname": "sl_leave_type",
      "label": "SL Leave Type",
      "fieldtype": "Link",
      "options": "Leave Type",
      "mandatory_depends_on": "eval:doc.enabled == 1 && doc.sl_rule == \"Approved Leave\""
    }
  ],
  "istable": 0,
  "track_changes": 1,
  "autoname": "field:company",
  "permissions": [
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ]
}
