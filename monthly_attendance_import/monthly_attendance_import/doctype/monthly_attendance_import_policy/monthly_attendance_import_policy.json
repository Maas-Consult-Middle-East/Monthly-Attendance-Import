  "istable": 0,
  "track_changes": 1,
  "autoname": "field:company",
  "permissions": [
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ]
}
