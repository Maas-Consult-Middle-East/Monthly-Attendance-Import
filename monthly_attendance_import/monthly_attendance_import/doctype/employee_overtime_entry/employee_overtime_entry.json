{
  "doctype": "DocType",
  "name": "Employee Overtime Entry",
  "module": "Monthly Attendance Import",
  "engine": "InnoDB",
  "field_order": [
    "employee",
    "company",
    "attendance_date",
    "overtime_hours",
    "attendance",
    "import_batch",
    "approval_status",
    "source_cells"
  ],
  "fields": [
    {
      "fieldname": "employee",
      "label": "Employee",
      "fieldtype": "Link",
      "options": "Employee",
      "reqd": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "attendance_date",
      "label": "Attendance Date",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "overtime_hours",
      "label": "Overtime Hours",
      "fieldtype": "Float",
      "precision": "2",
      "reqd": 1
    },
    {
      "fieldname": "attendance",
      "label": "Attendance",
      "fieldtype": "Link",
      "options": "Attendance"
    },
    {
      "fieldname": "import_batch",
      "label": "Import Batch",
      "fieldtype": "Link",
      "options": "Monthly Attendance Import",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "approval_status",
      "label": "Approval Status",
      "fieldtype": "Select",
      "options": "Pending\nApproved\nCancelled",
      "default": "Pending",
      "read_only": 1
    },
    {
      "fieldname": "source_cells",
      "label": "Source Cells",
      "fieldtype": "Data",
      "read_only": 1
    }
  ],
  "istable": 0,
  "track_changes": 1,
  "is_submittable": 1,
  "autoname": "format:EOH-{YYYY}-{#####}",
  "permissions": [
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "submit": 1,
      "cancel": 1
    }
  ]
}
